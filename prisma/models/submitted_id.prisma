model SubmittedId {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  idType      AcceptedIdType
  notes       String?
  presentedAt DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([employeeId, idType])
  @@index([employeeId])
}
