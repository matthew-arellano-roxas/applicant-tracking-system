model HiringRequest {
    id             String  @id @default(cuid())
    status         String
    position       String
    employmentType String // FULL_TIME, PART_TIME
    isTeaching     Boolean
    requirements   Json    @default("{}") // MOVED FROM JobPost
    departmentId   String
    campusId       Int

    campus     Campus     @relation(fields: [campusId], references: [id])
    department Department @relation(fields: [departmentId], references: [id])
    jobPosts   JobPost[]

    @@index([departmentId, campusId])
    @@index([status])
}
