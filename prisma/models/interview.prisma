model Interview {
    id           String    @id @default(cuid())
    applicantId  String
    applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
    interviewerId String?
    interviewer  User?     @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
    stage        String    @db.VarChar(30)  // HR_SCREENING, DEPARTMENT, DEMO_TEACHING, FINAL
    date         DateTime  @db.Timestamptz(3)
    type         String    @db.VarChar(20)  // ONSITE, ONLINE, PHONE
    status       String    @default("SCHEDULED") @db.VarChar(20)
    location     String?   @db.VarChar(255)
    instructions String?   // shown in the invitation email
    notes        String?   // interviewer remarks / evaluation
    createdAt    DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

    @@index([applicantId, date])
    @@index([status, date])
    @@index([interviewerId])
}