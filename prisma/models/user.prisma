model User {
    id          String  @id @default(cuid())
    firstName   String
    lastName    String
    email       String  @unique
    phoneNumber String?

    avatarUrl String?
    role      String  @default("APPLICANT")

    education String

    createdAt DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt DateTime? @db.Timestamptz(3)

    authIdentities AuthIdentity?
    employees      Employee[]
    jobPosts       JobPost[]
    applicants     Applicant[]
    cvs            CV?
    interviews     Interview[]

    @@index([role])
}
