model EmployeeDocument{
    id  String    @id @default(cuid())
    employeeId  String @unique
    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    sss String?
    philhealth String?
    pagIbig String?
    tin String?
    validIdPath String?
    tinDocumentPath String?
    sssDocumentPath String?
    philhealthDocumentPath String?
    pagIbigDocumentPath String?
    medicalRecordPath String?
    psaPath String?
    birFormPath String?
    nbiClearancePath String?
    governmentNumberPath String?
}
