# Local Docker Compose settings. Copy to .env and replace placeholders as needed.
POSTGRES_DB=applicant_tracking_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432
REDIS_CACHE_HOST_PORT=6379
REDIS_QUEUE_HOST_PORT=6380
API_HOST_PORT=3000
WEB_HOST_PORT=5173

FRONTEND_URL=http://localhost:5173
API_UPSTREAM=http://api:3000

# Optional overrides for the URLs used inside the API and worker containers.
# COMPOSE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/applicant_tracking_system?schema=public
# COMPOSE_REDIS_CACHE_URL=redis://redis-cache:6379
# COMPOSE_REDIS_QUEUE_URL=redis://redis-queue:6379

SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-smtp-password
GROQ_API_KEY=replace-with-groq-api-key
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
SEED_PASSWORD=choose-your-own-demo-password
