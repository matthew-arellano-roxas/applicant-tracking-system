  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsc",
    "start": "concurrently -k -n api,worker \"npm:start:api\" \"npm:start:worker\"",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "script": "ts-node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
