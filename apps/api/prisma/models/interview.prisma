model Interview {
  id              String                @id @default(cuid())
  applicantId     String
  interviewerId   String?
  stage           String                @db.VarChar(30)
  date            DateTime              @db.Timestamptz(3)
  durationMinutes Int                   @default(60)
  timeZone        String                @default("Asia/Manila") @db.VarChar(64)
  type            String                @db.VarChar(20)
  status          String                @default("SCHEDULED") @db.VarChar(20)
  location        String?               @db.VarChar(255)
  meetingUrl      String?               @db.VarChar(2048)
  instructions    String?
  notes           String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  applicant       Applicant             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer     User?                 @relation(fields: [interviewerId], references: [id])
  evaluations     InterviewEvaluation[]

  @@index([applicantId, date])
  @@index([status, date])
  @@index([interviewerId, date])
}

model InterviewEvaluation {
  id             String    @id @default(cuid())
  interviewId    String
  evaluatorId    String
  ratings        Json
  recommendation String    @db.VarChar(20)
  strengths      String?
  concerns       String?
  comments       String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  evaluator      User      @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, evaluatorId])
  @@index([evaluatorId])
}
