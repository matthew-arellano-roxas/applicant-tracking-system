model EmployeeDocumentStatus {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  validId       String // pending, complete
  tin           String
  sss           String
  philhealth    String
  pagIbig       String
  medicalRecord String
  psa           String
  birForm       String?
  nbiClearance  String
}
