model Applicant {
  id          String          @id @default(cuid())
  userId      String
  jobPostId   String
  status      String
  scoreStatus String          @default("PENDING")
  applyDate   DateTime        @default(now()) @db.Timestamptz(3)
  jobPost     JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores      ApplicantScore?
  interviews  Interview[]

  @@index([jobPostId, status])
  @@index([userId])
  @@index([status, applyDate])
  @@index([scoreStatus])
}
