@baseUrl = http://localhost:3000
@employeeId = replace-with-employee-id
@page = 1
@limit = 10

### List departments (page 1)
GET {{baseUrl}}/departments?page={{page}}&limit={{limit}}

### List departments (page 2)
GET {{baseUrl}}/departments?page=2&limit={{limit}}

### Find the College of Information Technology by name
# @name findItDepartment
GET {{baseUrl}}/departments?name=College%20of%20Information%20Technology&page={{page}}&limit={{limit}}

### Search departments by a partial name
GET {{baseUrl}}/departments?search=Information&page={{page}}&limit={{limit}}

### Only departments with an assigned department head
GET {{baseUrl}}/departments?hasDepartmentHead=true&page={{page}}&limit={{limit}}

### Find departments by name that have a department head
GET {{baseUrl}}/departments?name=College%20of%20Information%20Technology&hasDepartmentHead=true&page={{page}}&limit={{limit}}

### Create department
# @name createDepartment
POST {{baseUrl}}/departments
Content-Type: application/json

{
  "name": "Psychology"
}

### Get department
GET {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}

### Update department
PATCH {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}
Content-Type: application/json

{
  "name": "Finance and Accounting"
}

### Assign department head
PATCH {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/head
Content-Type: application/json

{
  "employeeId": "{{employeeId}}"
}

### Remove department head
DELETE {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/head

### List department members (page 1)
GET {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/members?page={{page}}&limit={{limit}}

### List department members (page 2)
GET {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/members?page=2&limit={{limit}}

### Search department members by name/email/position and filter teaching staff
GET {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/members?search=matthew&isTeaching=true&page={{page}}&limit={{limit}}

### Add department member
POST {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/members
Content-Type: application/json

{
  "employeeId": "{{employeeId}}"
}

### Remove department member
DELETE {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}/members/{{employeeId}}

### Delete department
DELETE {{baseUrl}}/departments/{{createDepartment.response.body.$.department.id}}
