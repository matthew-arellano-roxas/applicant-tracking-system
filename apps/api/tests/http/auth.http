@baseUrl = http://localhost:3000

### Login (REST Client reuses the session cookie for later requests to this host)
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "matthewroxas29@gmail.com",
  "password": "MatthewRoxas55!"
}

### Current user
# Expected response: { "user": { "id", "firstName", "lastName", "email", "role" } }
GET {{baseUrl}}/me

### Refresh session
POST {{baseUrl}}/refresh

### Logout
POST {{baseUrl}}/logout

### Register
POST {{baseUrl}}/register
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "email": "jane.doe@example.com",
  "password": "change-this-password",
  "education": "BSCS"
}

### Verify registration OTP
POST {{baseUrl}}/register/verify
Content-Type: application/json

{
  "email": "jane.doe@example.com",
  "otp": "enter-otp-from-email"
}

### Request a password reset code (response does not reveal whether the email is registered)
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
  "email": "jane.doe@example.com"
}

### Reset password with the emailed code
POST {{baseUrl}}/forgot-password/reset
Content-Type: application/json

{
  "email": "jane.doe@example.com",
  "otp": "enter-reset-code-from-email",
  "password": "new-password-here"
}
